# BIOS / Firmware (all optional -- embedded copies are used when absent)
notes = "(!) No BIOS files are required: the Jaguar boot ROM and CD BIOS images are embedded in the core.|(!) CD BIOS override (optional, real-BIOS CD boot): any ONE of [BIOS] Atari Jaguar CD (World).j64/.rom/.bin, [BIOS] Atari Jaguar Developer CD (World).j64/.rom/.bin, Jaguar CD BIOS.rom/.bin, jaguarcd_bios.bin, jagcd_bios.bin, jaguarcd.bin or jagcd.bin.|(!) Those are searched in the system directory and in its "Atari - Jaguar", "Atari - Jaguar CD", "jaguar" and "jaguarcd" subfolders. The image is identified by checksum, so the filename only sets search order - a "Missing" firmware entry above is harmless if you have any other accepted name.|(!) An optional jagboot_m.rom in the system directory overrides the embedded Model-M cart boot ROM.|(!) Cart BIOS Type 'Custom' (optional, real-BIOS cart boot): any ONE of jagboot.rom, boot.rom, boot0.rom, [BIOS] Atari Jaguar (World).j64, [BIOS] Atari Jaguar Stubulator '94 (World).j64 or [BIOS] Atari Jaguar Stubulator '93 (World).j64, searched in the system directory and its "Atari - Jaguar" and "jaguar" subfolders. Images are identified by checksum, not filename; an unrecognized 128 KB image still loads with a log warning."
firmware_count = 4
