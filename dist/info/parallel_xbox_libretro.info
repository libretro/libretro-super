# Software Information
display_name = "Microsoft - Xbox / Sega Chihiro (ParaLLEl Xbox)"
authors = "xemu-project team|Matt Borgerson"
supported_extensions = "iso|xiso|bin"
corename = "ParaLLEl Xbox"
categories = "Emulator"
license = "GPLv2"
permissions = ""
display_version = "Git"

# Hardware Information
manufacturer = "Microsoft"
systemname = "Xbox"
systemid = "xbox"

# Libretro Features
database = "Microsoft - Xbox"
supports_no_game = "false"
savestate = "false"
savestate_features = "null"
cheats = "false"
input_descriptors = "true"
memory_descriptors = "false"
libretro_saves = "false"
core_options = "true"
core_options_version = "2.0"
load_subsystem = "false"
hw_render = "true"
required_hw_api = "OpenGL Core >= 4.0 | Vulkan >= 1.1"
needs_fullpath = "true"
disk_control = "false"
is_experimental = "true"

# Firmware / BIOS
firmware_count = 10
firmware0_desc = "xemu/mcpx_1.0.bin (optional MCPX Boot ROM; experimental HLE when absent)"
firmware0_path = "xemu/mcpx_1.0.bin"
firmware0_opt = "true"
firmware1_desc = "xemu/Complex_4627v1.03.bin (Flash ROM / BIOS)"
firmware1_path = "xemu/Complex_4627v1.03.bin"
firmware1_opt = "false"
firmware2_desc = "xemu/xbox_hdd.img or xemu/xbox_hdd.qcow2 (Hard disk image, made when missing)"
firmware2_path = "xemu/xbox_hdd.img"
firmware2_opt = "true"
firmware3_desc = "xemu/xbox_eeprom.bin (EEPROM, created when missing)"
firmware3_path = "xemu/xbox_eeprom.bin"
firmware3_opt = "true"
firmware4_desc = "xemu/Chihiro/chihiro_xbox_bios.bin (Chihiro BIOS)"
firmware4_path = "xemu/Chihiro/chihiro_xbox_bios.bin"
firmware4_opt = "true"
firmware5_desc = "xemu/Chihiro/fpr21042_m29w160et.bin (Chihiro media board flash)"
firmware5_path = "xemu/Chihiro/fpr21042_m29w160et.bin"
firmware5_opt = "true"
firmware6_desc = "xemu/Chihiro/ic10_g24lc64.bin (Chihiro QC EEPROM)"
firmware6_path = "xemu/Chihiro/ic10_g24lc64.bin"
firmware6_opt = "true"
firmware7_desc = "xemu/Chihiro/ic11_24lc024.bin (Chihiro baseboard EEPROM)"
firmware7_path = "xemu/Chihiro/ic11_24lc024.bin"
firmware7_opt = "true"
firmware8_desc = "xemu/Chihiro/pc20_g24lc64.bin (Chihiro SC EEPROM)"
firmware8_path = "xemu/Chihiro/pc20_g24lc64.bin"
firmware8_opt = "true"
firmware9_desc = "xemu/Chihiro/ver1305.bin (Chihiro network firmware, for linked cabinets)"
firmware9_path = "xemu/Chihiro/ver1305.bin"
firmware9_opt = "true"

notes = "(!) The flash BIOS and hard disk image go into system/xemu/; mcpx_1.0.bin is optional (experimental MCPX 1.0 HLE when absent). Other names can be set in the core options.|(!) A ready-made hard disk image is on github.com/xemu-project/xemu-hdd-image.|(!) Renders with RetroArch's glcore or vulkan video driver; on macOS use glcore, on Android vulkan.|Game saves live inside the hard disk image (xbox_hdd.img, or an xbox_hdd.qcow2 shared with standalone xemu), not in the frontend save directory.|(!) Sega Chihiro games are .bin netboot images; the Chihiro files go into system/xemu/Chihiro/."
description = "A port of xemu, the original Xbox emulator, to libretro. It needs the console's MCPX boot ROM and flash BIOS, dumped from your own Xbox, and a hard disk image, in system/xemu/."
