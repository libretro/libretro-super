# BIOS/Firmware
firmware_count = 3

firmware0_desc = "same_cdi/bios/cdimono1.zip"
firmware0_path = "same_cdi/bios/cdimono1.zip"
firmware0_opt = "false"

firmware1_desc = "same_cdi/bios/cdimono2.zip"
